  {
   "tag": "h1",
   "id": null,
   "text": "Homotopy explorer"
  },
  {
   "tag": "label",
   "id": null,
   "text": "Category"
  },
  {
   "tag": "label",
   "id": null,
   "text": "Example"
  },
  {
   "tag": "p",
   "id": null,
   "text": "Same homotopy type: g∘f ≃ idX and f∘g ≃ idY."
  },
  {
   "tag": "button",
   "id": "eq-check-x",
   "text": "On X · ✕ g∘f ≃ id_X"
  },
  {
   "tag": "button",
