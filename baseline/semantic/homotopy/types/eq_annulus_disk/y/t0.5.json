  {
   "tag": "p",
   "id": "eq-x-name",
   "text": "X · annulus"
  },
  {
   "tag": "p",
   "id": "eq-y-name",
   "text": "Y · filled disk"
  },
  {
   "tag": "h2",
   "id": "eq-source-title",
   "text": "y · t = 0"
  },
  {
   "tag": "h2",
   "id": "eq-now-title",
   "text": "Homotopy Hₜ(y)"
  },
  {
   "tag": "h2",
