 "prose": [
  {
   "tag": "a",
   "id": null,
   "text": "← Unfold"
  },
  {
   "tag": "h1",
   "id": null,
   "text": "Homotopy explorer"
  },
  {
   "tag": "label",
   "id": null,
   "text": "Category"
  },
  {
   "tag": "select",
   "id": "choose-category",
   "text": "HomotopiesCan / cannotHomotopy classes (maps)Homotopy types (spaces)"
  },
  {
   "tag": "label",
   "id": null,
   "text": "Example"
  },
  {
   "tag": "select",
   "id": "choose-example",
   "text": "Segment → circle: open and shrinkDisk → choose Y — always worksInterval → diskPoint → circleCircle → circle: rotationCircle → disk: shrinkDisk → disk: contractionEdge → filled triangle"
  },
  {
   "tag": "label",
   "id": null,
   "text": "Target Y"
  },
  {
   "tag": "select",
   "id": "homotopy-diskTarget",
   "text": "Ring (annulus)CircleFilled diskFilled triangle"
  },
  {
   "tag": "button",
   "id": null,
   "text": "↻ Replay"
  },
  {
   "tag": "output",
   "id": null,
   "text": "1.00"
  },
  {
   "tag": "button",
   "id": "homotopy-connections",
   "text": "Connect points"
  },
  {
   "tag": "p",
   "id": null,
   "text": "Every continuous map f from a disk to Y can shrink to a constant: H(x,t) = f((1−t)x)."
  },
  {
   "tag": "p",
   "id": null,
   "text": "X = filled disk"
  },
  {
   "tag": "h2",
   "id": null,
   "text": "Input x"
  },
  {
   "tag": "p",
   "id": null,
   "text": "Y = filled disk"
  },
  {
   "tag": "h2",
   "id": null,
   "text": "Start f₀(x)"
  },
  {
   "tag": "h2",
   "id": null,
   "text": "Now fₜ(x)"
  },
  {
   "tag": "h2",
   "id": null,
   "text": "End f₁(x)"
  },
  {
   "tag": "p",
   "id": null,
   "text": "Same color = same input. Click or drag on a colored shape to circle corresponding points."
  },
  {
   "tag": "span",
   "id": null,
   "text": "Gray shows the fixed target Y."
  },
  {
   "tag": "summary",
   "id": null,
   "text": "Why?"
  },
  {
   "tag": "p",
   "id": null,
   "text": "Move the input x toward the disk’s center, then apply the original map f. At t = 0 this gives f(x); at t = 1 every input gives f(0)."
  },
  {
   "tag": "p",
   "id": null,
   "text": "This works for any target space Y and any continuous starting map f: disk → Y. The outputs stay in Y because they are always outputs of f. You are deforming the map; Y itself stays fixed."
  },
  {
   "tag": "p",
   "id": null,
   "text": "The selector shows four sample maps. For the circle target, several inputs share each output; circle an input in X to follow its color."
  }
 ],
